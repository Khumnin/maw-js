# ─────────────────────────────────────────────────────────────────────────────
# maw-js environment variables
#
# Copy this file to .env and customise for your deployment.
# All path variables accept absolute or relative paths.
# Relative paths are resolved from the process working directory (cwd).
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────

# Port the HTTP/WebSocket server listens on.
# Default: 3456
MAW_PORT=3456

# Hostname or IP of the remote machine running tmux sessions.
# Use "local" or "localhost" to manage sessions on the same machine.
# Default: white.local
MAW_HOST=white.local

# URL of the maw server, used by the MCP server client.
# Default: http://localhost:3456
MAW_URL=http://localhost:3456

# URL of the Oracle search/stats service.
# Default: http://localhost:47779
ORACLE_URL=http://localhost:47779

# ── Filesystem paths ──────────────────────────────────────────────────────────

# Base data directory. All app-managed data lives here by default.
# The directory is created automatically on startup if it does not exist.
# Default: ./data
MAW_DATA_DIR=./data

# SQLite database file path.
# Default: <MAW_DATA_DIR>/maw.db
# MAW_DB_PATH=/var/lib/maw/maw.db

# Directory containing Claude agent definition markdown files.
# Defaults to the standard Claude Code installation path (~/.claude/agents).
# Override for containerised deployments where the home dir is non-standard.
# Default: ~/.claude/agents
# MAW_AGENTS_DIR=/home/app/.claude/agents

# Temporary upload staging directory.
# Uploaded files are written here by POST /api/upload.
# The directory is created automatically on startup if it does not exist.
# Default: <MAW_DATA_DIR>/uploads
# MAW_UPLOAD_DIR=/tmp/maw-uploads

# Root of the Claude configuration directory.
# Used to locate JSONL session files and notification state JSON.
# Default: ~/.claude
# MAW_CLAUDE_DIR=/home/app/.claude

# Full path to the Claude Code projects directory that contains JSONL session
# files. Override when the project slug in the path differs from the default.
# When set, takes precedence over <MAW_CLAUDE_DIR>/projects/...
# Default: <MAW_CLAUDE_DIR>/projects/-Users-kanatekhumnin-Project
# MAW_CLAUDE_PROJECTS_DIR=/home/app/.claude/projects/-Users-myuser-Project

# ── Security ──────────────────────────────────────────────────────────────────

# Additional filesystem roots the path-validator middleware will permit,
# beyond the user home directory and upload staging area.
# Colon-separated list of absolute paths.
# Example: MAW_ALLOWED_ROOTS=/mnt/workspace:/data/shared
# MAW_ALLOWED_ROOTS=
