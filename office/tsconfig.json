{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@shared": ["../src/types/index.ts"],
      "@shared/*": ["../src/types/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "../src/types"]
}
